#!/usr/bin/env bash
# claude-sessions — Auto-resume Claude Code sessions after Mac restart
#
# How it works:
#   Claude Code tracks live sessions in ~/.claude/sessions/<PID>.json
#   These files persist on disk across restarts, but the PIDs die.
#   On login, this script reads those files and opens a terminal for each
#   dead-PID session with `claude --resume <session-id>`.
#
#   A backup daemon runs every 5min as a safety net, copying the
#   live session data to a backup file in case the session files get
#   cleaned up before the restore script runs.
#
# Config (~/.claude/session-manager/config):
#   CLAUDE_RESUME_FLAGS="--dangerously-skip-permissions"
#   TERMINAL="iTerm2"     (or "Terminal")
#   LAYOUT="tabs"          (tabs | windows | tmux)
set -euo pipefail

MANAGER_DIR="$HOME/.claude/session-manager"
SESSIONS_DIR="$HOME/.claude/sessions"
BACKUP="$MANAGER_DIR/backup-manifest.json"
CONFIG="$MANAGER_DIR/config"
LOG_DIR="$MANAGER_DIR/logs"
LOG_FILE="$LOG_DIR/claude-sessions.log"
LAUNCHAGENTS="$HOME/Library/LaunchAgents"
SNAPSHOT_LABEL="com.claude.session-snapshot"
RESTORE_LABEL="com.claude.session-restore"
MENUBAR_LABEL="com.claude.session-menubar"
NO_RESTORE_FLAG="$MANAGER_DIR/.no-restore"

# Defaults (overridden by config)
CLAUDE_RESUME_FLAGS=""
TERMINAL=""
LAYOUT="tabs"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

ensure_dirs() { mkdir -p "$MANAGER_DIR" "$LOG_DIR"; }

load_config() {
    if [[ -f "$CONFIG" ]]; then
        # shellcheck source=/dev/null
        source "$CONFIG"
    fi
}

log() {
    ensure_dirs
    if [[ -f "$LOG_FILE" ]] && [[ $(wc -l < "$LOG_FILE") -gt 1000 ]]; then
        tail -500 "$LOG_FILE" > "$LOG_FILE.tmp" && mv "$LOG_FILE.tmp" "$LOG_FILE"
    fi
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE"
}

detect_terminal() {
    # Config override
    if [[ -n "$TERMINAL" ]]; then
        echo "$TERMINAL"
        return
    fi
    if [[ -d "/Applications/iTerm.app" ]]; then
        echo "iTerm2"
    else
        echo "Terminal"
    fi
}

# Read all session files from ~/.claude/sessions/ and output pipe-delimited lines.
# Args: $1 = "alive" | "dead" | "all" (filter by PID status)
read_session_files() {
    local filter="${1:-all}"
    if [[ ! -d "$SESSIONS_DIR" ]]; then return; fi

    /usr/bin/python3 - "$SESSIONS_DIR" "$filter" <<'PYEOF'
import json, os, sys, glob

sessions_dir = sys.argv[1]
pid_filter = sys.argv[2]

for path in sorted(glob.glob(os.path.join(sessions_dir, "*.json"))):
    try:
        with open(path) as f:
            s = json.load(f)
    except (json.JSONDecodeError, FileNotFoundError):
        continue

    if s.get("kind") != "interactive" or s.get("entrypoint") != "cli":
        continue

    pid = s.get("pid", 0)
    try:
        os.kill(pid, 0)
        alive = True
    except (ProcessLookupError, PermissionError, OSError):
        alive = False

    if pid_filter == "alive" and not alive:
        continue
    if pid_filter == "dead" and alive:
        continue

    name = s.get("name", "")
    sid = s["sessionId"]
    cwd = s["cwd"]
    print(f"{sid}|{cwd}|{name}|{pid}|{'alive' if alive else 'dead'}")
PYEOF
}

# ─── SNAPSHOT ────────────────────────────────────────────────────────────────
cmd_snapshot() {
    ensure_dirs
    if [[ ! -d "$SESSIONS_DIR" ]]; then return 0; fi

    local count
    count=$(/usr/bin/python3 - "$SESSIONS_DIR" "$BACKUP" <<'PYEOF'
import json, os, sys, glob

sessions_dir, backup_path = sys.argv[1], sys.argv[2]
active = []

for path in sorted(glob.glob(os.path.join(sessions_dir, "*.json"))):
    try:
        with open(path) as f:
            s = json.load(f)
    except (json.JSONDecodeError, FileNotFoundError):
        continue
    if s.get("kind") != "interactive" or s.get("entrypoint") != "cli":
        continue
    try:
        os.kill(s["pid"], 0)
        active.append(s)
    except (ProcessLookupError, PermissionError, OSError):
        pass

if active:
    with open(backup_path, "w") as f:
        json.dump(active, f, indent=2)
# Never delete the backup — only the restore agent consumes it.
# This prevents the race where snapshot fires at login and nukes
# the backup before restore can read it.

print(len(active))
PYEOF
    )
    if [[ "${count:-0}" -gt 0 ]]; then
        log "Snapshot: $count active session(s) backed up"
    fi
}

# ─── RESTORE HELPERS ────────────────────────────────────────────────────────
# Basename of a path, used as a short display name for tabs/windows.
short_label() {
    local cwd="$1" name="${2:-}"
    if [[ -n "$name" ]]; then
        echo "$name"
    else
        basename "$cwd"
    fi
}

# Build the `claude --resume` command string for a single session.
build_resume_cmd() {
    local session_id="$1" cwd="$2" name="$3"
    local flags="${CLAUDE_RESUME_FLAGS:+ $CLAUDE_RESUME_FLAGS}"
    local cmd="cd '${cwd}' && claude${flags} --resume '${session_id}'"
    if [[ -n "$name" ]]; then
        cmd="cd '${cwd}' && claude${flags} --resume '${session_id}' --name '${name}'"
    fi
    echo "$cmd"
}

# ─── RESTORE: iTerm2 tabs layout ─────────────────────────────────────────────
# Opens one iTerm2 window titled "Claude Sessions (N)" and creates one tab
# per session. Each tab is named by its short label.
restore_iterm_tabs() {
    local sessions="$1"
    local count
    count=$(echo "$sessions" | wc -l | tr -d ' ')

    # Build one big AppleScript that creates a window and all tabs in sequence.
    # This is more reliable than one osascript per tab (avoids focus races).
    local script="tell application \"iTerm2\"
    activate
    set newWindow to (create window with default profile)
    set name of newWindow to \"Claude Sessions ($count)\"
"
    local first=true
    while IFS='|' read -r session_id cwd name pid status; do
        [[ ! -d "$cwd" ]] && continue
        local label cmd
        label=$(short_label "$cwd" "$name")
        cmd=$(build_resume_cmd "$session_id" "$cwd" "$name")
        # Escape double quotes and backslashes for AppleScript string literal
        local esc_cmd="${cmd//\\/\\\\}"
        esc_cmd="${esc_cmd//\"/\\\"}"
        local esc_label="${label//\"/\\\"}"

        if $first; then
            # The newly created window already has one session. Use it.
            script+="    tell current session of newWindow
        set name to \"$esc_label\"
        write text \"$esc_cmd\"
    end tell
"
            first=false
        else
            script+="    tell newWindow
        set newTab to (create tab with default profile)
        tell current session of newTab
            set name to \"$esc_label\"
            write text \"$esc_cmd\"
        end tell
    end tell
"
        fi
    done <<< "$sessions"
    script+="end tell"

    osascript <<< "$script"
}

# ─── RESTORE: Terminal.app tabs layout ──────────────────────────────────────
# Opens one Terminal window and uses `do script ... in front window` to get
# subsequent tabs via keystroke (⌘T). AppleScript tab support in Terminal.app
# is limited, so we rely on System Events to open new tabs.
restore_terminal_tabs() {
    local sessions="$1"
    local first=true
    while IFS='|' read -r session_id cwd name pid status; do
        [[ ! -d "$cwd" ]] && continue
        local cmd
        cmd=$(build_resume_cmd "$session_id" "$cwd" "$name")
        local esc_cmd="${cmd//\"/\\\"}"

        if $first; then
            osascript <<ASCRIPT
tell application "Terminal"
    activate
    do script "$esc_cmd"
end tell
ASCRIPT
            first=false
        else
            # Open a new tab in the frontmost Terminal window via ⌘T, then run the cmd in it.
            osascript <<ASCRIPT
tell application "Terminal" to activate
tell application "System Events" to keystroke "t" using {command down}
delay 0.3
tell application "Terminal"
    do script "$esc_cmd" in front window
end tell
ASCRIPT
        fi
        sleep 0.4
    done <<< "$sessions"
}

# ─── RESTORE: tmux layout ────────────────────────────────────────────────────
# Creates (or reuses) a tmux session named "claude" with one window per session.
# After completion, you attach with: tmux attach -t claude
restore_tmux() {
    local sessions="$1"
    if ! command -v tmux &>/dev/null; then
        log "Restore: tmux not installed, cannot use LAYOUT=tmux"
        echo -e "${RED}tmux not installed.${NC} brew install tmux, or set LAYOUT=tabs."
        return 1
    fi

    # Create session if it doesn't exist
    if ! tmux has-session -t claude 2>/dev/null; then
        tmux new-session -d -s claude -n bootstrap
        local created=true
    else
        local created=false
    fi

    while IFS='|' read -r session_id cwd name pid status; do
        [[ ! -d "$cwd" ]] && continue
        local label cmd
        label=$(short_label "$cwd" "$name")
        cmd=$(build_resume_cmd "$session_id" "$cwd" "$name")
        tmux new-window -t claude -n "$label" -c "$cwd" "$cmd"
    done <<< "$sessions"

    # Clean up the bootstrap window if we created it
    if $created; then
        tmux kill-window -t claude:bootstrap 2>/dev/null || true
    fi

    echo -e "${GREEN}Sessions restored in tmux.${NC} Attach with: tmux attach -t claude"
}

# ─── RESTORE: legacy one-window-per-session layout ──────────────────────────
restore_windows_legacy() {
    local sessions="$1"
    local terminal="$2"
    local i=0
    local count
    count=$(echo "$sessions" | wc -l | tr -d ' ')

    while IFS='|' read -r session_id cwd name pid status; do
        i=$((i + 1))
        [[ ! -d "$cwd" ]] && continue
        local cmd
        cmd=$(build_resume_cmd "$session_id" "$cwd" "$name")

        if [[ "$terminal" == "iTerm2" ]]; then
            osascript <<ASCRIPT
tell application "iTerm2"
    activate
    create window with default profile
    tell current session of current window
        write text "$cmd"
    end tell
end tell
ASCRIPT
        else
            osascript -e "tell application \"Terminal\"
    activate
    do script \"${cmd//\"/\\\"}\"
end tell"
        fi

        [[ $i -lt $count ]] && sleep 1
    done <<< "$sessions"
}

# ─── RESTORE ─────────────────────────────────────────────────────────────────
cmd_restore() {
    ensure_dirs
    load_config

    if [[ -f "$NO_RESTORE_FLAG" ]]; then
        log "Restore skipped: kill switch is set"
        return 0
    fi

    local delay="${1:-0}"
    if [[ "$delay" -gt 0 ]]; then
        log "Restore: waiting ${delay}s for system to settle..."
        sleep "$delay"
    fi

    # Primary source: backup manifest (created while sessions were alive, survives restart)
    local sessions=""
    if [[ -f "$BACKUP" ]]; then
        log "Restore: reading backup manifest"
        sessions=$(/usr/bin/python3 - "$BACKUP" <<'PYEOF'
import json, os, sys

with open(sys.argv[1]) as f:
    data = json.load(f)

for s in data:
    if s.get("kind") != "interactive" or s.get("entrypoint") != "cli":
        continue
    pid = s.get("pid", 0)
    try:
        os.kill(pid, 0)
        continue  # alive, skip — already running
    except:
        pass
    name = s.get("name", "")
    print(f"{s['sessionId']}|{s['cwd']}|{name}|{pid}|dead")
PYEOF
        )
    fi

    # Fallback: session files with dead PIDs (in case backup doesn't exist)
    if [[ -z "$sessions" ]]; then
        log "Restore: no backup or all alive, checking session files"
        sessions=$(read_session_files "dead")
    fi

    if [[ -z "$sessions" ]]; then
        log "Restore: nothing to restore"
        return 0
    fi

    local count
    count=$(echo "$sessions" | wc -l | tr -d ' ')
    local terminal
    terminal=$(detect_terminal)
    local layout="${LAYOUT:-tabs}"

    log "Restore: resuming $count session(s) — terminal=$terminal layout=$layout flags=${CLAUDE_RESUME_FLAGS:-none}"

    # Print the list for logs / interactive invocations
    local i=0
    while IFS='|' read -r session_id cwd name pid status; do
        i=$((i + 1))
        local display="${name:-${session_id:0:8}...}"
        echo -e "  ${GREEN}[$i/$count]${NC} ${BOLD}$display${NC} ${DIM}$cwd${NC}"
    done <<< "$sessions"

    case "$layout" in
        tmux)
            restore_tmux "$sessions"
            ;;
        windows)
            restore_windows_legacy "$sessions" "$terminal"
            ;;
        tabs|*)
            if [[ "$terminal" == "iTerm2" ]]; then
                restore_iterm_tabs "$sessions"
            else
                restore_terminal_tabs "$sessions"
            fi
            ;;
    esac

    [[ -f "$BACKUP" ]] && mv "$BACKUP" "${BACKUP%.json}.restored.json" 2>/dev/null || true

    osascript -e "display notification \"Restored $count Claude session(s) ($layout)\" with title \"Claude Sessions\" sound name \"Glass\"" 2>/dev/null || true

    log "Restore: $count session(s) resumed ($layout)"
    echo -e "\n${GREEN}Restored $count session(s) ($layout).${NC}"
}

# ─── STATUS ──────────────────────────────────────────────────────────────────
cmd_status() {
    ensure_dirs
    load_config
    echo ""

    local snap_ok=false rest_ok=false menu_ok=false
    launchctl list "$SNAPSHOT_LABEL" &>/dev/null && snap_ok=true
    launchctl list "$RESTORE_LABEL" &>/dev/null && rest_ok=true
    launchctl list "$MENUBAR_LABEL" &>/dev/null && menu_ok=true

    if $snap_ok && $rest_ok; then
        echo -e "  ${GREEN}●${NC}  Session manager is ${GREEN}active${NC}"
    elif $snap_ok || $rest_ok; then
        echo -e "  ${YELLOW}◐${NC}  Partially installed — run: claude-sessions install"
    else
        echo -e "  ${RED}○${NC}  Not installed — run: claude-sessions install"
    fi

    if $menu_ok; then
        echo -e "  ${GREEN}●${NC}  Menu bar item is ${GREEN}running${NC}"
    fi

    [[ -f "$NO_RESTORE_FLAG" ]] && echo -e "  ${YELLOW}!${NC}  Auto-restore ${YELLOW}disabled${NC}"
    [[ -n "$CLAUDE_RESUME_FLAGS" ]] && echo -e "  ${DIM}   Resume flags: $CLAUDE_RESUME_FLAGS${NC}"
    echo -e "  ${DIM}   Layout: ${LAYOUT:-tabs}${NC}"

    echo ""

    local alive_sessions dead_sessions
    alive_sessions=$(read_session_files "alive" | wc -l | tr -d ' ')
    dead_sessions=$(read_session_files "dead" | wc -l | tr -d ' ')

    echo -e "  Live sessions:    ${GREEN}${alive_sessions}${NC}"
    echo -e "  Stale (dead PID): ${DIM}${dead_sessions}${NC}"

    if [[ -f "$BACKUP" ]]; then
        local backup_count backup_age
        backup_count=$(/usr/bin/python3 -c "import json; print(len(json.load(open('$BACKUP'))))" 2>/dev/null || echo "?")
        backup_age=$(( $(date +%s) - $(stat -f %m "$BACKUP") ))
        echo -e "  Backup:           ${BLUE}${backup_count}${NC} session(s), ${backup_age}s ago"
    else
        echo -e "  Backup:           ${DIM}(none)${NC}"
    fi

    echo ""
    local all_sessions
    all_sessions=$(read_session_files "all")
    if [[ -n "$all_sessions" ]]; then
        echo -e "  ${DIM}SESSION ID   STATUS   NAME                         DIRECTORY${NC}"
        while IFS='|' read -r sid cwd name pid status; do
            local short_sid="${sid:0:8}"
            local short_cwd="${cwd/#$HOME/~}"
            local label="${name:-—}"
            if [[ "$status" == "alive" ]]; then
                echo -e "  ${short_sid}   ${GREEN}alive ${NC}  ${label:0:28}  ${DIM}${short_cwd}${NC}"
            else
                echo -e "  ${short_sid}   ${DIM}dead  ${NC}  ${label:0:28}  ${DIM}${short_cwd}${NC}"
            fi
        done <<< "$all_sessions"
    else
        echo -e "  ${DIM}No sessions found.${NC}"
    fi
    echo ""
}

# ─── INSTALL ─────────────────────────────────────────────────────────────────
cmd_install() {
    ensure_dirs
    local script_path="$MANAGER_DIR/claude-sessions"
    chmod +x "$script_path"

    # Create default config if it doesn't exist
    if [[ ! -f "$CONFIG" ]]; then
        cat > "$CONFIG" <<'CONF'
# claude-sessions config
# Extra flags passed to `claude` on resume (e.g. --dangerously-skip-permissions)
CLAUDE_RESUME_FLAGS=""

# Terminal to use: "iTerm2" or "Terminal" (auto-detected if empty)
TERMINAL=""

# Restore layout:
#   tabs    — one window with one tab per session (default)
#   windows — one window per session (old behavior)
#   tmux    — one tmux session "claude" with one window per session
LAYOUT="tabs"
CONF
    fi

    mkdir -p "$LAUNCHAGENTS"

    cat > "$LAUNCHAGENTS/$SNAPSHOT_LABEL.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$SNAPSHOT_LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>$script_path</string>
        <string>snapshot</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>$LOG_DIR/snapshot-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>$LOG_DIR/snapshot-stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/bin:/usr/bin:/usr/local/bin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>$HOME</string>
    </dict>
</dict>
</plist>
PLIST

    cat > "$LAUNCHAGENTS/$RESTORE_LABEL.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$RESTORE_LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>$script_path</string>
        <string>restore</string>
        <string>10</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>$LOG_DIR/restore-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>$LOG_DIR/restore-stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/bin:/usr/bin:/usr/local/bin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>$HOME</string>
    </dict>
</dict>
</plist>
PLIST

    launchctl bootout "gui/$(id -u)/$SNAPSHOT_LABEL" 2>/dev/null || true
    launchctl bootout "gui/$(id -u)/$RESTORE_LABEL" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$LAUNCHAGENTS/$SNAPSHOT_LABEL.plist"
    launchctl bootstrap "gui/$(id -u)" "$LAUNCHAGENTS/$RESTORE_LABEL.plist"

    local bin_dir="$HOME/.local/bin"
    mkdir -p "$bin_dir"
    ln -sf "$script_path" "$bin_dir/claude-sessions"

    log "Installed LaunchAgents and symlink"

    echo -e "${GREEN}Installed.${NC}"
    echo ""
    echo "  Snapshot daemon: backs up session data every 5min"
    echo "  Restore agent:   resumes sessions 10s after login"
    echo "  Config:          $CONFIG"
    echo ""
    echo -e "  ${DIM}CLI: $bin_dir/claude-sessions${NC}"
    echo ""
    echo "  claude-sessions status             What's running now"
    echo "  claude-sessions restore            Manually resume dead sessions"
    echo "  claude-sessions menubar install    Add menu bar item (optional)"
    echo "  claude-sessions disable            Skip next auto-restore"
    echo "  claude-sessions enable             Re-enable auto-restore"
    echo "  claude-sessions uninstall          Remove everything"
    echo ""
}

# ─── UNINSTALL ───────────────────────────────────────────────────────────────
cmd_uninstall() {
    launchctl bootout "gui/$(id -u)/$SNAPSHOT_LABEL" 2>/dev/null || true
    launchctl bootout "gui/$(id -u)/$RESTORE_LABEL" 2>/dev/null || true
    launchctl bootout "gui/$(id -u)/$MENUBAR_LABEL" 2>/dev/null || true
    rm -f "$LAUNCHAGENTS/$SNAPSHOT_LABEL.plist"
    rm -f "$LAUNCHAGENTS/$RESTORE_LABEL.plist"
    rm -f "$LAUNCHAGENTS/$MENUBAR_LABEL.plist"
    rm -f "$HOME/.local/bin/claude-sessions"
    echo -e "${GREEN}Uninstalled.${NC} Data preserved in $MANAGER_DIR"
    log "Uninstalled"
}

# ─── ENABLE / DISABLE ───────────────────────────────────────────────────────
cmd_disable() {
    touch "$NO_RESTORE_FLAG"
    echo -e "${YELLOW}Auto-restore disabled.${NC} Run 'claude-sessions enable' to re-enable."
}

cmd_enable() {
    rm -f "$NO_RESTORE_FLAG"
    echo -e "${GREEN}Auto-restore enabled.${NC}"
}

# ─── MENU BAR ────────────────────────────────────────────────────────────────
MENUBAR_SCRIPT_URL_DEFAULT="https://raw.githubusercontent.com/amer313/claude-sessions/main/claude-sessions-menubar.py"
MENUBAR_VENV="$MANAGER_DIR/venv"

# Find a Python that can actually build rumps (needs pyobjc → >=3.10 preferred).
# Tries common locations; falls back to `python3` on PATH.
find_python_for_menubar() {
    local candidates=(
        "/opt/homebrew/bin/python3.13"
        "/opt/homebrew/bin/python3.12"
        "/opt/homebrew/bin/python3.11"
        "/opt/homebrew/bin/python3"
        "/usr/local/bin/python3.13"
        "/usr/local/bin/python3.12"
        "/usr/local/bin/python3.11"
        "/usr/local/bin/python3"
    )
    for p in "${candidates[@]}"; do
        [[ -x "$p" ]] && { echo "$p"; return; }
    done
    # Fallback: anything on PATH that isn't the system 3.9
    if command -v python3 &>/dev/null; then
        local ver
        ver=$(python3 -c 'import sys; print(sys.version_info[:2])')
        # System /usr/bin/python3 on current macOS is 3.9 — rumps/pyobjc install is flaky.
        if [[ "$ver" != "(3, 9)" ]]; then
            command -v python3
        fi
    fi
}

cmd_menubar() {
    local sub="${1:-status}"
    local menubar_py="$MANAGER_DIR/claude-sessions-menubar.py"

    case "$sub" in
        install)
            ensure_dirs
            echo "Setting up menu bar item..."

            # Copy the menubar script from alongside this one, or download it.
            local script_dir src
            script_dir="$(cd "$(dirname "$0")" && pwd)"
            src="$script_dir/claude-sessions-menubar.py"
            if [[ -f "$src" && "$src" != "$menubar_py" ]]; then
                cp "$src" "$menubar_py"
            elif [[ ! -f "$menubar_py" ]]; then
                curl -fsSL "$MENUBAR_SCRIPT_URL_DEFAULT" -o "$menubar_py"
            fi
            chmod +x "$menubar_py"

            # Create a dedicated venv and install rumps into it.
            # This avoids depending on /usr/bin/python3 (system 3.9, pyobjc-core
            # yanked on 3.9) or user site-packages which has path quirks.
            local py
            py=$(find_python_for_menubar)
            if [[ -z "$py" ]]; then
                echo -e "${RED}No suitable Python 3.10+ found.${NC}"
                echo "Install one: brew install python"
                return 1
            fi
            echo "Using $py"

            if [[ ! -x "$MENUBAR_VENV/bin/python" ]]; then
                echo "Creating venv at $MENUBAR_VENV ..."
                "$py" -m venv "$MENUBAR_VENV" || {
                    echo -e "${RED}Failed to create venv.${NC}"
                    return 1
                }
            fi

            echo "Installing rumps into venv ..."
            "$MENUBAR_VENV/bin/pip" install --quiet --upgrade pip >/dev/null 2>&1 || true
            "$MENUBAR_VENV/bin/pip" install --quiet rumps || {
                echo -e "${RED}Failed to install rumps.${NC}"
                echo "Manual fix: $MENUBAR_VENV/bin/pip install rumps"
                return 1
            }

            # Sanity check: can we import rumps?
            if ! "$MENUBAR_VENV/bin/python" -c "import rumps" 2>/dev/null; then
                echo -e "${RED}rumps installed but import failed.${NC}"
                return 1
            fi

            mkdir -p "$LAUNCHAGENTS"
            cat > "$LAUNCHAGENTS/$MENUBAR_LABEL.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$MENUBAR_LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>$MENUBAR_VENV/bin/python</string>
        <string>$menubar_py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>$LOG_DIR/menubar-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>$LOG_DIR/menubar-stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/bin:/usr/bin:/usr/local/bin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>$HOME</string>
    </dict>
</dict>
</plist>
PLIST

            launchctl bootout "gui/$(id -u)/$MENUBAR_LABEL" 2>/dev/null || true
            launchctl bootstrap "gui/$(id -u)" "$LAUNCHAGENTS/$MENUBAR_LABEL.plist"
            log "Menu bar installed (python=$py)"
            echo -e "${GREEN}Menu bar item installed.${NC} Look for ⎋ in your menu bar."
            ;;
        uninstall)
            launchctl bootout "gui/$(id -u)/$MENUBAR_LABEL" 2>/dev/null || true
            rm -f "$LAUNCHAGENTS/$MENUBAR_LABEL.plist"
            # Leave the venv on disk — cheap to keep, saves a reinstall later.
            log "Menu bar uninstalled"
            echo -e "${GREEN}Menu bar item removed.${NC} (venv preserved at $MENUBAR_VENV)"
            ;;
        run)
            # Run directly in the foreground (for manual testing)
            if [[ ! -f "$menubar_py" ]]; then
                echo -e "${RED}Menu bar not installed.${NC} Run: claude-sessions menubar install"
                return 1
            fi
            if [[ -x "$MENUBAR_VENV/bin/python" ]]; then
                exec "$MENUBAR_VENV/bin/python" "$menubar_py"
            else
                echo -e "${RED}Venv missing.${NC} Run: claude-sessions menubar install"
                return 1
            fi
            ;;
        status|*)
            if launchctl list "$MENUBAR_LABEL" &>/dev/null; then
                echo -e "${GREEN}Menu bar running.${NC}"
            else
                echo -e "${DIM}Menu bar not running.${NC} Install with: claude-sessions menubar install"
            fi
            ;;
    esac
}

# ─── MAIN ────────────────────────────────────────────────────────────────────
case "${1:-status}" in
    snapshot)   cmd_snapshot ;;
    restore)    cmd_restore "${2:-0}" ;;
    status)     cmd_status ;;
    install)    cmd_install ;;
    uninstall)  cmd_uninstall ;;
    disable)    cmd_disable ;;
    enable)     cmd_enable ;;
    menubar)    cmd_menubar "${2:-status}" ;;
    *)
        echo "claude-sessions — Auto-resume Claude Code after Mac restart"
        echo ""
        echo "  status              Show live/dead sessions and agent status"
        echo "  restore             Resume all dead-PID sessions now"
        echo "  snapshot            Back up current session data"
        echo "  install             Set up LaunchAgents for auto-snapshot + auto-restore"
        echo "  uninstall           Remove LaunchAgents"
        echo "  disable             Skip next auto-restore"
        echo "  enable              Re-enable auto-restore"
        echo "  menubar install     Add menu bar status item (opt-in)"
        echo "  menubar uninstall   Remove menu bar status item"
        exit 1
        ;;
esac
